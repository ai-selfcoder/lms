DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-dev-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000

# OAuth
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI-ментор (Claude). Без ключа фича отдаёт 503, приложение работает.
ANTHROPIC_API_KEY=
MENTOR_MODEL=claude-haiku-4-5
MENTOR_MAX_TOKENS=4000

# Провайдер AI-ментора: deepseek (дёшево) | anthropic
MENTOR_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
