DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-dev-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Comma-separated allowlist for the admin console.
ADMIN_EMAILS=admin@example.com

# OAuth
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
# Shared only with the Next.js server. Required to turn a grader PASS into a
# product entitlement such as solution notes; use a long random value in prod.
GRADER_SYNC_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI-ментор (Claude). Без ключа фича отдаёт 503, приложение работает.
ANTHROPIC_API_KEY=
MENTOR_MODEL=claude-haiku-4-5
MENTOR_MAX_TOKENS=4000
# Per-account burst protection and provider timeout.
MENTOR_RATE_LIMIT=5
MENTOR_RATE_WINDOW_MS=600000
MENTOR_REQUEST_TIMEOUT_MS=30000

# Провайдер AI-ментора: deepseek (дёшево) | anthropic
MENTOR_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
