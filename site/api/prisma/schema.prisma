// To switch to Postgres: set `provider = "postgresql"` below and
// DATABASE_URL="postgresql://user:pass@localhost:5432/goroutine?schema=public" in .env.
generator client {
  provider = "prisma-client-js"
  // node:20-alpine is musl + OpenSSL 3 — pin the engine so Prisma doesn't
  // mis-detect libssl (otherwise the schema engine fails to start at runtime).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?
  provider     String?
  providerId   String?
  level        String?
  createdAt    DateTime       @default(now())
  progress     TaskProgress[]
  comments     TaskComment[]
  solutionNotes TaskSolutionNote[]
  verifiedPasses TaskPass[]
  learningEvents LearningEvent[]
  ownedTeams    Team[]       @relation("TeamOwner")
  teamMemberships TeamMember[]
  entitlements Entitlement[]
  careerProfile CareerProfile?
  skillReports SkillReport[]
  checkoutIntents CheckoutIntent[]
  teamBaselines TeamBaselineAssessment[]

  @@unique([provider, providerId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

// Short, text-only takeaways from people who have passed a task. These are
// separate from open questions so their publishing policy stays explicit.
model TaskSolutionNote {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId, createdAt])
}

// Created only by the server-side grading proxy after a grader PASS. Product
// entitlements use this record, never optional analytics events from a client.
model TaskPass {
  id              String   @id @default(cuid())
  userId          String
  taskId          String
  courseId        String   @default("go")
  taskTitle       String?
  taskSlug        String?
  difficulty      String?
  testsPassed     Int?
  testsTotal      Int?
  graderLatencyMs Int?
  firstAttemptAt  DateTime?
  lastAttemptAt   DateTime?
  passedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId, passedAt])
}

model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  source    String   @default("manual")
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, plan])
}

model CareerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  goal      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillReport {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique @default(cuid())
  title       String
  goal        String?
  payloadJson String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([token, isPublic])
}

// A checkout intent is separate from payment state. It measures pricing
// demand before a provider is connected, without presenting a manual grant as
// an active subscription.
model CheckoutIntent {
  id              String   @id @default(cuid())
  userId          String
  plan            String
  priceHypothesis String?
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([plan, status, createdAt])
}

model TaskProgress {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  solved    Boolean  @default(true)
  solvedAt  DateTime @default(now())
  code      String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model LearningEvent {
  id        String   @id
  userId    String
  type      String
  itemId    String
  courseId  String?
  occurredAt DateTime
  metaJson  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([itemId, occurredAt])
}

// A private workspace is deliberately a thin coordination layer: it stores a
// team-owned sequence of task identifiers, never a learner's submitted code.
model Team {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  tracks    TeamTrack[]
  baselines TeamBaselineAssessment[]

  @@index([ownerId, createdAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, createdAt])
}

// A point-in-time team progress snapshot. It stores task ids and counts only,
// so managers can measure growth without accessing submitted source code.
model TeamBaselineAssessment {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  taskIdsJson String
  passedCount Int      @default(0)
  totalCount  Int      @default(0)
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
}

model TeamTrack {
  id          String          @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  items       TeamTrackItem[]

  @@index([teamId, createdAt])
}

model TeamTrackItem {
  id        String    @id @default(cuid())
  trackId   String
  taskId    String
  position  Int
  createdAt DateTime  @default(now())
  track     TeamTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, taskId])
  @@unique([trackId, position])
}
