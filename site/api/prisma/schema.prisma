// To switch to Postgres: set `provider = "postgresql"` below and
// DATABASE_URL="postgresql://user:pass@localhost:5432/goroutine?schema=public" in .env.
generator client {
  provider = "prisma-client-js"
  // node:20-alpine is musl + OpenSSL 3 — pin the engine so Prisma doesn't
  // mis-detect libssl (otherwise the schema engine fails to start at runtime).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?
  provider     String?
  providerId   String?
  level        String?
  createdAt    DateTime       @default(now())
  progress     TaskProgress[]

  @@unique([provider, providerId])
}

model TaskProgress {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  solved    Boolean  @default(true)
  solvedAt  DateTime @default(now())
  code      String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}
