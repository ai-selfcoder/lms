# ── Coolify / docker-compose environment ────────────────────────────────────
# Copy to `.env` for local runs, or paste these as Environment Variables in the
# Coolify resource. Values marked (secret) should be set in Coolify's secrets.

# Public URLs (the domains you attach in Coolify). PUBLIC_API_URL is baked into
# the web client bundle at build time — rebuild web after changing it.
PUBLIC_WEB_URL=https://learn.example.com
PUBLIC_API_URL=https://api.learn.example.com

# Host port mappings (ignored when Coolify fronts services with its own proxy).
WEB_PORT=3000
API_PORT=4000

# API — auth (secret). Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Piston sandbox (external host). Grader posts go test -race here via the
# custom `gotest` package. Firewall its :2000 to the app host only.
PISTON_URL=http://your-sandbox-host:2000
PISTON_VERSION=1.26.4

# OAuth providers (optional — leave blank to disable). Callback URLs:
#   GitHub : ${PUBLIC_API_URL}/auth/github/callback
#   Google : ${PUBLIC_API_URL}/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI-mentor — the only paid feature. Without a key the endpoint returns 503 and
# everything else keeps working. Provider: deepseek (cheap) | anthropic.
MENTOR_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
MENTOR_MODEL=claude-haiku-4-5
MENTOR_MAX_TOKENS=4000
