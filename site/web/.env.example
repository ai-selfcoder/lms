# URL of the Go grader service (POST /api/run). Server-side only.
# Local dev with the grader running on the host:
GRADER_URL=http://localhost:8090

# Base URL of the NestJS auth/progress API. Exposed to the browser, so it must
# be prefixed NEXT_PUBLIC_. Used for email/password + GitHub/Google OAuth and
# progress sync. Local dev default:
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side base URL of the NestJS API. Used by the AI-mentor proxy routes
# (/api/mentor, /api/mentor/status) so the Anthropic key never reaches the
# browser. Local dev default:
API_URL=http://localhost:4000
